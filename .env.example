# SteriCare Service Platform: environment variables.
# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase (Dashboard > Project Settings > API Keys)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_..., or the legacy anon key). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_..., or the legacy service_role key). Server only.
# Never prefix with NEXT_PUBLIC_ and never import lib/supabase/admin.ts in client code.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Database connection for the Supabase CLI only (migrations: supabase db push).
# The app never reads it. Dashboard > Connect > Session pooler > URI, with your
# database password filled in. Keep it out of git and out of Vercel.
# ---------------------------------------------------------------------------
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin of this app, no trailing slash. Used in invite and
# password-reset email links. Set to the Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The /design sign-off page is hidden in production builds. Set to true to show
# it on a preview deployment (for example a Vercel preview) during sign-off.
ENABLE_DESIGN_PAGE=

# ---------------------------------------------------------------------------
# AI hand-offs (BUILD_SPEC section 9). All optional.
# Unset means the app shows "AI not connected" and offers a JSON download.
# ---------------------------------------------------------------------------
# 9.1 AI report: the export JSON is POSTed here; the response returns the report URL.
AI_REPORT_WEBHOOK_URL=
# 9.2 AI second opinion: the export JSON is POSTed here; the response is an AiReview.
AI_REVIEW_WEBHOOK_URL=
# Shared secret used to sign webhook requests (HMAC-SHA256, header X-SteriCare-Signature).
AI_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI models (optional). Lets the second opinion run directly on Claude
# when no review webhook is set.
# ---------------------------------------------------------------------------
# Anthropic API key (console.anthropic.com > API Keys). Server only.
ANTHROPIC_API_KEY=
# Which reviewer to use: auto (webhook, then Claude, then off), webhook, claude, mock or off.
AI_REVIEW_PROVIDER=auto
# Claude model for the second opinion.
AI_REVIEW_MODEL=claude-opus-5-5
# Reasoning effort for the second opinion: low, medium, high, xhigh or max.
AI_REVIEW_EFFORT=high
