/**
 * Writes the seed templates of BUILD_SPEC 11 (STD_EG, SAFEDON_EG, STD_SG) to
 * the templates table from lib/templates/definitions/seed-bundle.json:
 * active, or with --drafts as drafts for an admin to check and activate.
 * Without --apply it is a dry run: it shows what would change and writes
 * nothing.
 *
 *   npm run seed:templates                    dry run
 *   npm run seed:templates -- --apply         writes it
 *
 * npm run seed:templates runs node --env-file-if-exists=.env.local
 * scripts/seed-templates.mts, so it writes to the Supabase project that
 * .env.local names, and says which. Options go after the --. npm takes an
 * option written before it (npm run seed:templates --drafts) as its own, and
 * the script never sees it. npm leaves a trace of it in an npm_config_
 * variable, so the script then stops without writing and shows the command
 * with the options after the --.
 *
 * Run order on a project:
 *   1. supabase/seed.sql (npx supabase db push --include-seed): reference
 *      data. SAFEDON_EG belongs to the client "Polyco Healthline", found by
 *      name; without it the run stops before writing anything.
 *   2. npm run seed:templates: the dry run, one line per template. Check that
 *      it lists STD_EG, SAFEDON_EG (with its client) and STD_SG, and that it
 *      gives no warning about placeholder modules.
 *   3. npm run seed:templates -- --apply (or --apply --drafts): writes what
 *      the dry run listed.
 * The first seed into a project without seed templates needs no --replace.
 * A run with an unchanged bundle writes nothing. After the bundle is
 * regenerated, a changed definition (or with --refresh a changed resolution,
 * such as new module defaults) becomes a new version; while a seeded version
 * is active, retiring it needs --replace, and without it the run stops
 * before writing anything.
 *
 * Options:
 *   --apply        write; without it the run only shows what would change
 *   --dry-run      write nothing, even with --apply
 *   --replace      retire an active version that differs from the bundle;
 *                  without it, the run stops before writing anything
 *   --drafts       write new versions as drafts and activate or retire
 *                  nothing: an admin attaches the source form, confirms the
 *                  coverage checklist and activates each one in the template
 *                  editor (BUILD_SPEC 4.2 rule 10, 4.5)
 *   --allow-stubs  write although the bundle was made while some modules were
 *                  still placeholders (their default labels are then missing
 *                  from the stored resolution; regenerate the bundle instead)
 *   --refresh      also make a new version when only the resolution changed
 *                  (new module defaults), not the definition
 *
 * Every template is planned first, bases first, then written:
 *   - the active version has the same definition (and was resolved against
 *     the same base versions): nothing is written, so a second run with the
 *     same bundle changes nothing;
 *   - no version is active: a draft with the definition is activated, or a
 *     new version (highest + 1) is added, active;
 *   - another version is active: templates belong to admins once seeded
 *     (BUILD_SPEC 4.1), so it may be an admin's newer version. The run stops
 *     before writing anything unless --replace is given; with it, the draft
 *     is activated or a new version added, and the active one retired.
 * With --drafts, a version (active or draft) that already has the definition
 * is kept; otherwise a new version is added as a draft. Nothing active
 * changes, so --replace is never needed.
 * A version is retired, never edited: a version an inspection uses is frozen
 * (BUILD_SPEC 4.2 rule 8), and a code has one active version. A retired
 * version can be made active again in the template editor.
 * Coverage is not marked confirmed and no source form is stored: a script
 * with the secret key has no admin to record. The seeds are checked against
 * the data dictionary by the tests in lib/coverage.
 *
 * Needs Node 22.18+ (built-in TypeScript, so no path aliases here) and
 * NEXT_PUBLIC_SUPABASE_URL plus SUPABASE_SECRET_KEY in .env.local. The bundle
 * is generated by lib/templates/definitions/seed-bundle.test.ts.
 */
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { parseArgs } from "node:util";
import { createClient } from "@supabase/supabase-js";
import type { Database, Json } from "../lib/supabase/database.types";

/* ------------------------------------------------------------------ *
 * The bundle
 * ------------------------------------------------------------------ */

export const BUNDLE_PATH = new URL("../lib/templates/definitions/seed-bundle.json", import.meta.url);
export const REGENERATE = "UPDATE_TEMPLATE_SEEDS=1 npx vitest run lib/templates/definitions/seed-bundle.test.ts";

type JsonObject = { [key: string]: Json | undefined };
type Scope = { productType: string; standard: string; clientId?: string; manufacturerId?: string };
type Base = { code: string; version: number };

export type BundleTemplate = {
  code: string;
  client: string | null;
  definition: JsonObject & { code: string; extends?: string; scope: Scope; sourceFile?: string };
  resolved: JsonObject & { code: string; chain: string[]; bases: Base[]; scope: Scope };
};

export type Bundle = { format: 1; about: string; stubModules: string[]; templates: BundleTemplate[] };

const CODE_PATTERN = /^[A-Z][A-Z0-9_]*$/;

function isObject(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

/** The bundle, checked for the shape this script relies on (its content is tested where it is generated). */
export function parseBundle(text: string): Bundle {
  const bundle: unknown = JSON.parse(text);
  const fail = (message: string): never => {
    throw new Error(`seed-bundle.json: ${message}. Regenerate it with ${REGENERATE}`);
  };
  if (!isObject(bundle) || bundle.format !== 1) fail("unknown format");
  const { templates, stubModules } = bundle as Record<string, unknown>;
  if (!Array.isArray(templates) || templates.length === 0) fail("no templates");
  if (!Array.isArray(stubModules) || stubModules.some((key) => typeof key !== "string")) fail("bad stubModules");
  const seen = new Set<string>();
  for (const entry of templates as unknown[]) {
    if (!isObject(entry) || typeof entry.code !== "string" || !CODE_PATTERN.test(entry.code)) fail("a template without a code");
    const { code, client, definition, resolved } = entry as Record<string, unknown>;
    if (client !== null && typeof client !== "string") fail(`${code}: bad client`);
    if (!isObject(definition) || definition.code !== code || !isObject(definition.scope)) fail(`${code}: bad definition`);
    if (!isObject(resolved) || resolved.code !== code || !Array.isArray(resolved.chain) || !Array.isArray(resolved.bases)) {
      fail(`${code}: bad resolution`);
    }
    const parent = (definition as Record<string, unknown>).extends;
    if (parent !== undefined && !seen.has(String(parent))) fail(`${code} comes before its base ${String(parent)}`);
    if (seen.has(code as string)) fail(`${code} appears twice`);
    seen.add(code as string);
  }
  return bundle as Bundle;
}

/* ------------------------------------------------------------------ *
 * Planning: pure, so it is tested without a database
 * ------------------------------------------------------------------ */

export type TemplateStatus = Database["public"]["Enums"]["template_status"];

export type VersionRow = { id: string; version: number; status: TemplateStatus; definition: Json; resolved: Json | null };

export type Wanted = { code: string; definition: BundleTemplate["definition"]; resolved: BundleTemplate["resolved"] };

export type Plan =
  | { action: "keep"; code: string; version: number; id: string }
  | { action: "activate"; code: string; version: number; id: string; retire: { id: string; version: number } | null }
  | { action: "insert"; code: string; version: number; retire: { id: string; version: number } | null };

/** Structural equality of JSON values; key order does not matter (jsonb reorders keys). */
export function jsonEqual(a: unknown, b: unknown): boolean {
  if (a === b) return true;
  if (Array.isArray(a) || Array.isArray(b)) {
    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((item, index) => jsonEqual(item, b[index]));
  }
  if (isObject(a) && isObject(b)) {
    const keys = Object.keys(a).filter((key) => a[key] !== undefined);
    const other = Object.keys(b).filter((key) => b[key] !== undefined);
    return keys.length === other.length && keys.every((key) => key in b && jsonEqual(a[key], b[key]));
  }
  return false;
}

/**
 * The definition and resolution as they are written: the client's id in a
 * client-scoped template's scope, and each base at the version it has now.
 */
export function prepare(entry: BundleTemplate, clientId: string | null, baseVersions: ReadonlyMap<string, number>): Wanted {
  const scope = (current: Scope): Scope => {
    const rest = Object.fromEntries(Object.entries(current).filter(([key]) => key !== "clientId")) as Scope;
    return clientId === null ? rest : { ...rest, clientId };
  };
  const bases = entry.resolved.chain.slice(1).map((code) => {
    const version = baseVersions.get(code);
    if (version === undefined) throw new Error(`${entry.code} extends ${code}, which is not seeded before it.`);
    return { code, version };
  });
  return {
    code: entry.code,
    definition: { ...entry.definition, scope: scope(entry.definition.scope) },
    resolved: { ...entry.resolved, scope: scope(entry.resolved.scope), bases },
  };
}

/** Whether a stored version already is what the seed wants. */
export function sameVersion(row: VersionRow, wanted: Wanted, { refresh }: { refresh: boolean }): boolean {
  if (!isObject(row.resolved) || !jsonEqual(row.definition, wanted.definition)) return false;
  return refresh ? jsonEqual(row.resolved, wanted.resolved) : jsonEqual(row.resolved.bases, wanted.resolved.bases);
}

/** The plan retires the active version: it replaces what may be an admin's change since the seed. */
export function replacesActive(plan: Plan): boolean {
  return plan.action !== "keep" && plan.retire !== null;
}

export type PlanOptions = {
  refresh: boolean;
  /** Add new versions as drafts; activate and retire nothing. */
  drafts?: boolean;
};

export function planTemplate(wanted: Wanted, rows: readonly VersionRow[], options: PlanOptions): Plan {
  const active = rows.find((row) => row.status === "active") ?? null;
  const retire = active === null ? null : { id: active.id, version: active.version };
  if (active !== null && sameVersion(active, wanted, options)) {
    return { action: "keep", code: wanted.code, version: active.version, id: active.id };
  }
  const draft = rows
    .filter((row) => row.status === "draft" && sameVersion(row, wanted, options))
    .sort((a, b) => b.version - a.version)[0];
  const version = rows.reduce((highest, row) => Math.max(highest, row.version), 0) + 1;
  if (options.drafts) {
    // Drafts wait for an admin: one that already has the definition is enough.
    if (draft) return { action: "keep", code: wanted.code, version: draft.version, id: draft.id };
    return { action: "insert", code: wanted.code, version, retire: null };
  }
  if (draft) return { action: "activate", code: wanted.code, version: draft.version, id: draft.id, retire };
  return { action: "insert", code: wanted.code, version, retire };
}

/** The status a planned version has, or has once the plan is carried out. */
export function plannedStatus(plan: Plan, rows: readonly VersionRow[], options: Pick<PlanOptions, "drafts">): TemplateStatus {
  if (plan.action === "keep") return rows.find((row) => row.id === plan.id)?.status ?? "active";
  return options.drafts ? "draft" : "active";
}

/** The templates columns a definition sets (lib/templates/versions.ts templateRowFields). */
export function rowFields(wanted: Wanted) {
  const { definition } = wanted;
  return {
    code: definition.code,
    extends_code: definition.extends ?? null,
    product_type: definition.scope.productType as Database["public"]["Enums"]["product_type"],
    standard: definition.scope.standard as Database["public"]["Enums"]["standard_code"],
    client_id: definition.scope.clientId ?? null,
    manufacturer_id: definition.scope.manufacturerId ?? null,
    definition: definition as NonNullable<Json>,
    resolved: wanted.resolved as NonNullable<Json>,
    source_file_path: definition.sourceFile ?? null,
  };
}

/** A client by name, as supabase/seed.sql spells it; case and outer spaces do not matter. */
export function findClient(clients: readonly { id: string; name: string }[], name: string): string | null {
  const key = name.trim().toLowerCase();
  return clients.find((client) => client.name.trim().toLowerCase() === key)?.id ?? null;
}

/* ------------------------------------------------------------------ *
 * Running it
 * ------------------------------------------------------------------ */

/** What the seed needs from the database; main() binds it to Supabase with the secret key. */
export type SeedDatabase = {
  clients(): Promise<{ id: string; name: string }[]>;
  versions(code: string): Promise<VersionRow[]>;
  insert(row: ReturnType<typeof rowFields> & { version: number; status: TemplateStatus }): Promise<string>;
  setStatus(id: string, status: TemplateStatus): Promise<void>;
};

export type SeedOptions = { dryRun: boolean; refresh: boolean; replace: boolean; drafts?: boolean };

export type SeedOutcome = {
  plan: Plan;
  client: string | null;
  /** The status the version has, or has once written: drafts with --drafts. */
  status: TemplateStatus;
  /** It would retire the active version, and --replace was not given: nothing is written. */
  blocked: boolean;
};

export type SeedReport = { outcomes: SeedOutcome[]; written: boolean };

/**
 * Plans every template, bases first, then carries the plans out in that
 * order, unless it is a dry run or a plan would retire an active version
 * without --replace: then nothing is written. With --drafts nothing active
 * changes, so nothing stops it.
 */
export async function seedTemplates(db: SeedDatabase, bundle: Bundle, options: SeedOptions): Promise<SeedReport> {
  if (options.drafts && options.replace) {
    throw new Error("Use --drafts or --replace, not both: drafts never retire an active version.");
  }
  const clients = bundle.templates.some((entry) => entry.client !== null) ? await db.clients() : [];
  const clientIds = new Map<string, string>();
  for (const entry of bundle.templates) {
    if (entry.client === null) continue;
    const id = findClient(clients, entry.client);
    if (id === null) {
      throw new Error(
        `${entry.code} belongs to the client "${entry.client}", which is not in the clients table. ` +
          "Seed the reference data first (supabase/seed.sql).",
      );
    }
    clientIds.set(entry.code, id);
  }

  // A child is resolved against the version its base will have, so planning needs no writes.
  const planned: { plan: Plan; wanted: Wanted; outcome: SeedOutcome }[] = [];
  const versions = new Map<string, number>();
  for (const entry of bundle.templates) {
    const wanted = prepare(entry, clientIds.get(entry.code) ?? null, versions);
    const rows = await db.versions(entry.code);
    const plan = planTemplate(wanted, rows, options);
    versions.set(entry.code, plan.version);
    const outcome: SeedOutcome = {
      plan,
      client: entry.client,
      status: plannedStatus(plan, rows, options),
      blocked: !options.replace && replacesActive(plan),
    };
    planned.push({ plan, wanted, outcome });
  }
  const outcomes = planned.map((entry) => entry.outcome);
  if (options.dryRun || outcomes.some((outcome) => outcome.blocked)) return { outcomes, written: false };
  for (const { plan, wanted } of planned) await carryOut(db, plan, wanted, options);
  return { outcomes, written: true };
}

/**
 * A new version goes in as a draft while another is active, then the old one
 * is retired and the new one activated; if that fails, the old one is put
 * back, so the code is never left without an active version. With --drafts
 * the new version stays a draft.
 */
async function carryOut(db: SeedDatabase, plan: Plan, wanted: Wanted, options: Pick<SeedOptions, "drafts">): Promise<void> {
  if (plan.action === "keep") return;
  const status = options.drafts || plan.retire ? "draft" : "active";
  const id = plan.action === "activate" ? plan.id : await db.insert({ ...rowFields(wanted), version: plan.version, status });
  if (plan.retire === null) {
    if (plan.action === "activate") await db.setStatus(id, "active");
    return;
  }
  await db.setStatus(plan.retire.id, "retired");
  try {
    await db.setStatus(id, "active");
  } catch (error) {
    await db.setStatus(plan.retire.id, "active").catch(() => undefined);
    throw error;
  }
}

/** One line per template; `planned` when nothing was written (a dry run, or a run that stopped). */
export function describeOutcome(outcome: SeedOutcome, planned: boolean): string {
  const { plan, client, status, blocked } = outcome;
  const head = `${plan.code.padEnd(12)} version ${plan.version}`;
  const retired = plan.action !== "keep" && plan.retire ? `, version ${plan.retire.version} ${planned ? "to retire" : "retired"}` : "";
  const what =
    plan.action === "keep"
      ? `unchanged, ${status}`
      : plan.action === "activate"
        ? `${planned ? "to activate (an existing draft)" : "activated (an existing draft)"}${retired}`
        : `${planned ? "to add" : "added"}, ${status}${retired}`;
  return `${head}  ${what}${client ? ` · client ${client}` : ""}${blocked ? " (needs --replace)" : ""}`;
}

/** Why a run stops when it would retire an active version, and what to do. */
export function describeBlocked(outcomes: readonly SeedOutcome[], dryRun: boolean): string | null {
  const blocked = outcomes.filter((outcome) => outcome.blocked);
  if (blocked.length === 0) return null;
  const which = blocked
    .map(({ plan }) => (plan.action !== "keep" && plan.retire ? `${plan.code} version ${plan.retire.version}` : plan.code))
    .join(", ");
  const them = blocked.length === 1 ? "it" : "them";
  return (
    `Active now and different from the bundle: ${which}. An admin may have changed ${them} since the seed. ` +
    `${dryRun ? "A real run stops" : "Stopped"} before writing anything: check ${them}, ` +
    `then run again with --replace to retire ${them}.`
  );
}

/* ------------------------------------------------------------------ *
 * The command line: pure, so it is tested without npm or a database
 * ------------------------------------------------------------------ */

export const SEED_COMMAND = "npm run seed:templates";
export const USAGE = `${SEED_COMMAND} -- [--apply] [--drafts | --replace] [--refresh] [--allow-stubs] [--dry-run]`;

const OPTIONS = {
  apply: { type: "boolean" },
  "dry-run": { type: "boolean" },
  drafts: { type: "boolean" },
  replace: { type: "boolean" },
  refresh: { type: "boolean" },
  "allow-stubs": { type: "boolean" },
  help: { type: "boolean" },
} as const;

/** The options that change a run, in the order a suggested command lists them. */
const RUN_FLAGS = ["apply", "dry-run", "drafts", "replace", "refresh", "allow-stubs"] as const;
export type RunFlag = (typeof RUN_FLAGS)[number];

export type Environment = Readonly<Record<string, string | undefined>>;

/**
 * The script's options that npm took as its own because they came before the
 * -- (npm run seed:templates --drafts). The script never sees them; npm
 * leaves them in npm_config_ variables, as npm 11 spells them: --apply is
 * expanded into npm's shorthands -a -p -l -y (all, parseable, long, yes), and
 * --replace into --replace-registry-host, which takes the next word as its
 * value, even another option (--replace --drafts gives "--drafts").
 */
export function swallowedByNpm(env: Environment): RunFlag[] {
  const set = (name: string) => env[`npm_config_${name}`] === "true";
  const found = new Set<RunFlag>();
  if (set("apply") || ["all", "parseable", "long", "yes"].every(set)) found.add("apply");
  if (set("dry_run")) found.add("dry-run");
  if (set("drafts")) found.add("drafts");
  if (set("refresh")) found.add("refresh");
  if (set("allow_stubs")) found.add("allow-stubs");
  const registryHost = env.npm_config_replace_registry_host;
  if (set("replace") || registryHost === "true" || registryHost?.startsWith("-")) {
    found.add("replace");
    const taken = RUN_FLAGS.find((flag) => registryHost === `--${flag}`);
    if (taken) found.add(taken);
  }
  return RUN_FLAGS.filter((flag) => found.has(flag));
}

export type RunOptions = { seed: SeedOptions & { drafts: boolean }; allowStubs: boolean };

export type CommandLine = { kind: "help" } | { kind: "refuse"; message: string } | ({ kind: "run" } & RunOptions);

function wordList(words: readonly string[]): string {
  return words.length <= 1 ? words.join("") : `${words.slice(0, -1).join(", ")} and ${words.at(-1)}`;
}

/**
 * What to do, from the script's arguments and the npm_config_ variables npm
 * set: a dry run unless --apply is given, and nothing at all when npm took
 * one of the options as its own.
 */
export function parseCommandLine(argv: readonly string[], env: Environment): CommandLine {
  const refuse = (message: string): CommandLine => ({ kind: "refuse", message: `${message}\nUsage: ${USAGE}` });
  const { tokens } = parseArgs({ args: [...argv], options: OPTIONS, strict: false, allowPositionals: true, tokens: true });
  const given = new Set<string>();
  for (const token of tokens) {
    if (token.kind === "positional") return refuse(`Unexpected argument "${token.value}".`);
    if (token.kind !== "option") continue;
    if (!Object.hasOwn(OPTIONS, token.name)) return refuse(`Unknown option ${token.rawName}.`);
    if (token.value !== undefined) return refuse(`${token.rawName} takes no value.`);
    given.add(token.name);
  }
  if (given.has("help")) return { kind: "help" };

  const swallowed = swallowedByNpm(env);
  if (swallowed.length > 0) {
    const options = RUN_FLAGS.filter((flag) => given.has(flag) || swallowed.includes(flag)).map((flag) => `--${flag}`);
    const one = swallowed.length === 1;
    return {
      kind: "refuse",
      message:
        `npm took ${wordList(swallowed.map((flag) => `--${flag}`))} as ${one ? "its own option" : "its own options"}, ` +
        `so the script never saw ${one ? "it" : "them"}. Nothing was written.\n` +
        `Put the options after the --: ${SEED_COMMAND} -- ${options.join(" ")}`,
    };
  }
  if (given.has("drafts") && given.has("replace")) {
    return { kind: "refuse", message: "Use --drafts or --replace, not both: drafts never retire an active version." };
  }
  return {
    kind: "run",
    seed: {
      dryRun: given.has("dry-run") || !given.has("apply"),
      drafts: given.has("drafts"),
      replace: given.has("replace"),
      refresh: given.has("refresh"),
    },
    allowStubs: given.has("allow-stubs"),
  };
}

/** The command that writes what a dry run with these options showed. */
export function writeCommand({ seed, allowStubs }: RunOptions): string {
  const flags = [
    "--apply",
    ...(seed.drafts ? ["--drafts"] : []),
    ...(seed.replace ? ["--replace"] : []),
    ...(seed.refresh ? ["--refresh"] : []),
    ...(allowStubs ? ["--allow-stubs"] : []),
  ];
  return `${SEED_COMMAND} -- ${flags.join(" ")}`;
}

/** The last line of a dry run: how to write what it showed, when a run with --apply would write it. */
export function describeDryRun(report: SeedReport, options: RunOptions): string {
  const head = "Nothing was written: this was a dry run.";
  if (report.outcomes.some((outcome) => outcome.blocked)) return head;
  if (report.outcomes.every((outcome) => outcome.plan.action === "keep")) return `${head} There is nothing to write.`;
  return `${head} To write it: ${writeCommand(options)}`;
}

/* ------------------------------------------------------------------ *
 * Supabase and the run
 * ------------------------------------------------------------------ */

/** The data of a Supabase answer, or an error naming what failed. */
function dataOf<T>(what: string, result: { data: T | null; error: { message: string } | null }): T {
  if (result.error || result.data === null) throw new Error(`${what} failed: ${result.error?.message ?? "no data"}`);
  return result.data;
}

function supabaseDatabase(url: string, secretKey: string): SeedDatabase {
  const supabase = createClient<Database>(url, secretKey, {
    auth: { autoRefreshToken: false, persistSession: false },
  });
  return {
    clients: async () => dataOf("Reading clients", await supabase.from("clients").select("id, name")),
    versions: async (code) =>
      dataOf(
        `Reading ${code}`,
        await supabase.from("templates").select("id, version, status, definition, resolved").eq("code", code),
      ),
    insert: async (row) => {
      const result = await supabase.from("templates").insert(row).select("id").single();
      return dataOf(`Adding ${row.code} version ${row.version}`, result).id;
    },
    setStatus: async (id, status) => {
      const result = await supabase.from("templates").update({ status }).eq("id", id).select("id");
      if (dataOf(`Setting template ${id} ${status}`, result).length !== 1) {
        throw new Error(`Setting template ${id} ${status} failed: no such template.`);
      }
    },
  };
}

async function main(): Promise<void> {
  const command = parseCommandLine(process.argv.slice(2), process.env);
  if (command.kind === "help") {
    console.log(USAGE);
    console.log("Without --apply it is a dry run. Run order and options: the comment at the top of scripts/seed-templates.mts.");
    return;
  }
  if (command.kind === "refuse") {
    console.error(command.message);
    process.exit(1);
  }
  const { dryRun } = command.seed;

  const url = process.env.NEXT_PUBLIC_SUPABASE_URL?.trim();
  const secretKey = process.env.SUPABASE_SECRET_KEY?.trim();
  if (!url || !secretKey) {
    console.error("Set NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY in .env.local first.");
    process.exit(1);
  }
  const project = new URL(url).hostname;

  const bundle = parseBundle(readFileSync(BUNDLE_PATH, "utf8"));
  if (bundle.stubModules.length > 0) {
    console.warn(
      `The bundle was made while these modules were placeholders: ${bundle.stubModules.join(", ")}.\n` +
        `Their default labels are missing from the resolved templates. Once they are built, run\n  ${REGENERATE}\n`,
    );
    if (!dryRun && !command.allowStubs) {
      console.error("Nothing written. Regenerate the bundle first, or pass --allow-stubs to seed it as it is.");
      process.exit(1);
    }
  }

  const report = await seedTemplates(supabaseDatabase(url, secretKey), bundle, command.seed);
  console.log(`Seed templates in ${project}${dryRun ? ", dry run" : report.written ? "" : ", nothing written"}:`);
  for (const outcome of report.outcomes) console.log(`  ${describeOutcome(outcome, !report.written)}`);
  const blocked = describeBlocked(report.outcomes, dryRun);
  if (blocked) console.error(`\n${blocked}`);
  const drafts = report.outcomes.filter((outcome) => outcome.status === "draft").map((outcome) => outcome.plan.code);
  if (drafts.length > 0) {
    console.log(
      `\nDrafts: ${drafts.join(", ")}. Inspectors cannot start from them until an admin attaches the source form, ` +
        "confirms the coverage checklist and activates each one under Admin > Templates, bases first.",
    );
  }
  if (dryRun) console.log(`\n${describeDryRun(report, command)}`);
  else if (!report.written) process.exit(1);
}

// Run only when started as a script, so tests can import the functions above.
if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
  main().catch((error: unknown) => {
    console.error(error instanceof Error ? error.message : error);
    process.exit(1);
  });
}
